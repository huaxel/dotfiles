[Unit]
Description=llama.cpp embedding server for Memoryfield
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'exec /opt/cachy-llama/bin/llama-server --hf-repo nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0 --embedding --pooling mean --host "$(/usr/bin/tailscale ip -4)" --port 8001 --threads 8 --batch-size 512'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
