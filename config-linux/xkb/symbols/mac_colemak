// Colemak multilingual layout with Mac-style modifier placement.
// The base layout supplies the standard Colemak accent and symbol layer.
partial alphanumeric_keys
xkb_symbols "basic" {
    name[Group1] = "English (Colemak)";
    include "us(colemak_base)"

    // Match the Windows/Mac physical modifier arrangement: swap only the
    // left Alt and left Win, while preserving right Alt as Option/AltGr.
    include "altwin(swap_lalt_lwin)"
    key <RALT> { [ ISO_Level3_Shift ] };
    key <RWIN> { [ Super_R ] };

    // ISO key immediately beside left Shift produces ASCII tilde.
    key <LSGT> { [ asciitilde, asciitilde, asciitilde, asciitilde ] };
};
