#!/bin/bash
# Pre-commit hook for local CI checks + auto-encrypting secrets
# Runs before every commit:
#   1. `just check-precommit` — fast syntax/config checks (<1s)
#   2. Auto-encrypts secrets whose plaintext is newer than the committed .enc
#
# Enable:  git config core.hooksPath .githooks
# (bootstrap.sh does this automatically.)

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SECRETS_DIR="$DOTFILES_DIR/secrets"

# ──────────────────────────────────────────────────────
# Step 1: Run just check-precommit (fast CI checks)
# ──────────────────────────────────────────────────────
if command -v just &>/dev/null; then
    cd "$DOTFILES_DIR"
    if ! just check-precommit 2>&1; then
        echo "❌ Pre-commit checks failed. Fix the issues above or use --no-verify to skip."
        exit 1
    fi
else
    echo "⚠️  just not installed — skipping fast CI checks (install: brew/cargo install just)"
fi

# ──────────────────────────────────────────────────────
# Step 2: Auto-encrypt secrets
# ──────────────────────────────────────────────────────

# Skip if sops isn't installed
if ! command -v sops &>/dev/null; then
    echo "⚠️  sops not installed — skipping secret auto-encrypt (install: brew/pacman install sops)"
    exit 0
fi

# encrypt_secret <live plaintext path> <enc basename without .enc>
# Only re-encrypts when the plaintext content actually changes (tracked via
# a SHA256 sidecar).  Without this guard, sops's random nonce produces
# different ciphertext on every commit, causing spurious binary conflicts
# during rebase.
encrypt_secret() {
    local live="$1" name="$2"
    local enc="$SECRETS_DIR/$name.enc"
    local hash_file="$SECRETS_DIR/$name.sha256"

    [ -f "$live" ] || return 0

    # Content-hash guard: skip encryption if the plaintext hasn't changed.
    local current_hash
    current_hash="$(sha256sum "$live" | cut -d' ' -f1)"
    if [ -f "$enc" ] && [ -f "$hash_file" ] && [ "$(cat "$hash_file" 2>/dev/null)" = "$current_hash" ]; then
        return 0
    fi

    echo "🔐 Auto-encrypting $name from $live..."
    local staging="$SECRETS_DIR/.tmp.$name"
    local tmpout
    tmpout="$(mktemp)"
    cp "$live" "$staging"
    if sops --encrypt --input-type binary "$staging" >"$tmpout"; then
        rm -f "$staging"
        mv "$tmpout" "$enc"
        echo "$current_hash" >"$hash_file"
        git add "$enc" "$hash_file"
        echo "   ✅ $name auto-encrypted and added to commit"
    else
        rm -f "$staging" "$tmpout"
        echo "   ❌ Failed to encrypt $name. Aborting commit."
        return 1
    fi
}

# Shell secrets: systemd environment.d (single source for all shells)
encrypt_secret "$HOME/.config/environment.d/99-environment.conf" "environment.d"

# App-specific secrets (live plaintext path -> enc basename)
encrypt_secret "$HOME/.config/llama.cpp/webui-config.json" "llama-webui-config.json"
# NOTE: pi/agent/auth.json is intentionally NOT synced. OpenAI Codex (and other
# OAuth providers: meta, commandcode) use single-use refresh tokens that rotate
# on every refresh, so a shared credential desyncs across machines
# (refresh_token_reused). Each machine owns its own gitignored auth.json and
# runs `/login openai-codex` (etc.) independently. Static API-key providers are
# still shared via the synced environment.d env vars above.
encrypt_secret "$HOME/dotfiles/pi/agent/quota-sessions.json" "pi-quota-sessions.json"

# Legacy warning
if [ -f "$HOME/.config/secrets/env.sh" ] || [ -f "$HOME/.config/secrets/env.fish" ]; then
    echo "⚠️  Warning: a legacy env.sh/env.fish secret file exists. Secrets now live in"
    echo "   ~/.config/environment.d/99-environment.conf (encrypted as secrets/environment.d.enc)."
    echo "   Remove the legacy file once its keys are migrated."
fi

exit 0
