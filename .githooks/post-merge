#!/bin/bash
# Post-merge hook: redeploy dotfiles after a pull/merge
# This ensures secrets are decrypted, templates re-rendered, and symlinks
# refreshed whenever the repo changes via git pull / merge.
#
# Only runs if dotter is installed and the .dotter directory exists.

set -e

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Git hooks run with a minimal, non-interactive PATH, so dotter installed to
# ~/.cargo/bin (cargo) or a package prefix may not be on PATH. Resolve it from
# PATH first, then fall back to the usual install locations.
DOTTER="$(command -v dotter 2>/dev/null || true)"
if [ -z "$DOTTER" ]; then
    for cand in "$HOME/.cargo/bin/dotter" /usr/local/bin/dotter \
                /opt/homebrew/bin/dotter /usr/bin/dotter; do
        [ -x "$cand" ] && { DOTTER="$cand"; break; }
    done
fi

if [ -z "$DOTTER" ]; then
    echo "⚠️  post-merge: dotter not found — skipping auto-deploy"
    exit 0
fi

if [ ! -f "$DOTFILES_DIR/.dotter/global.toml" ]; then
    exit 0
fi

cd "$DOTFILES_DIR"
"$DOTTER" deploy
