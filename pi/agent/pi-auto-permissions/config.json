{
  "enabled": true,
  "rules": [
    {
      "pattern": "\\bgit\\s+commit\\b",
      "flags": "i",
      "level": "guarded",
      "group": "git",
      "label": "Git commit"
    },
    {
      "pattern": "\\bgit\\s+push\\b",
      "flags": "i",
      "level": "guarded",
      "group": "git",
      "label": "Git push"
    },
    {
      "pattern": "\\bnpm\\s+publish\\b",
      "flags": "i",
      "level": "guarded",
      "group": "npm",
      "label": "npm publish"
    },
    {
      "pattern": "\\bgit\\s+(?:reset\\s+--hard|clean\\b)",
      "flags": "i",
      "level": "guarded",
      "group": "git-destructive",
      "label": "Destructive Git cleanup"
    },
    {
      "pattern": "\\bgit\\s+(?:restore|checkout)\\b[^\\n]*--",
      "flags": "i",
      "level": "guarded",
      "group": "git-destructive",
      "label": "Discard Git changes"
    },
    {
      "pattern": "\\brm\\s+-[^\\n]*r",
      "flags": "i",
      "level": "guarded",
      "group": "filesystem-destructive",
      "label": "Recursive file deletion"
    },
    {
      "pattern": "\\b(?:sudo|doas)\\b",
      "flags": "i",
      "level": "guarded",
      "group": "system",
      "label": "Privileged command"
    },
    {
      "pattern": "\\b(?:kubectl|helm|terraform|pulumi)\\s+(?:apply|destroy|delete|rollout)\\b",
      "flags": "i",
      "level": "guarded",
      "group": "deployment",
      "label": "Deployment mutation"
    }
  ]
}
