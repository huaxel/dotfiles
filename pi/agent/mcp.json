{
  "mcpServers": {
    "cloudflare-builds": {
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "exposure": "direct",
      "enabled": false
    },
    "Executor": {
      "url": "https://mcp.executor.sh/mcp",
      "enabled": false
    },
    "cua-driver": {
      "command": "~/.local/bin/cua-driver",
      "args": [
        "mcp"
      ],
      "description": "Background computer-use driver: window snapshots plus click/type/scroll input that doesn't steal the cursor",
      "enabled": false
    },
    "motherduck": {
      "url": "https://api.motherduck.com/mcp"
    },
    "colab": {
      "url": "https://colaboratory.googleapis.com/mcp",
      "exposure": "hidden",
      "description": "Inspect and run code in existing Google Colab runtimes; no runtime creation or deletion.",
      "toolExposure": {
        "list_runtimes": "codemode",
        "get_runtime": "codemode",
        "list_sessions": "codemode",
        "execute_code": "codemode"
      }
    }
  }
}
