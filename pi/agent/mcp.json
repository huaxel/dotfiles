{
  "mcpServers": {
    "cloudflare-builds": {
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "exposure": "direct",
      "enabled": false
    },
    "Executor": {
      "url": "https://mcp.executor.sh/mcp",
      "enabled": false
    },
    "cua-driver": {
      "command": "~/.local/bin/cua-driver",
      "args": [
        "mcp"
      ],
      "description": "Background computer-use driver: window snapshots plus click/type/scroll input that doesn't steal the cursor",
      "enabled": false
    }
  }
}
