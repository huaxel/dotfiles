+
+function gitProjectRoot(cwd: string): string | null {
+	try {
+		const topLevel = execFileSync("git", ["-C", cwd, "rev-parse", "--show-toplevel"], {
+			encoding: "utf8",
+			stdio: ["ignore", "pipe", "ignore"],
+		}).trim();
+		if (!topLevel) return null;
+
+		// Worktrees share the main repository's git common dir, so they share
+		// project memory instead of silently fragmenting it per worktree.
+		const commonDir = execFileSync("git", ["-C", cwd, "rev-parse", "--git-common-dir"], {
+			encoding: "utf8",
+			stdio: ["ignore", "pipe", "ignore"],
+		}).trim();
+		if (!commonDir) return path.resolve(topLevel);
+		const resolvedCommonDir = path.resolve(cwd, commonDir);
+		return path.basename(resolvedCommonDir) === ".git" ? path.dirname(resolvedCommonDir) : path.resolve(topLevel);
+	} catch {
+		return null;
+	}
+}
+
+function projectKey(projectRoot: string): string {
+	const label = path.basename(projectRoot).replace(/[^A-Za-z0-9._-]/g, "-") || "project";
+	const digest = createHash("sha256").update(projectRoot).digest("hex").slice(0, 12);
+	return `${label}-${digest}`;
+}
+
+export function resolveMemoryScope(cwd: string, env: MemoryEnv = process.env): MemoryScope {
+	const baseDir = resolveMemoryDir(env);
+	// An explicit PI_MEMORY_DIR remains an exact override for compatibility.
+	if (env.PI_MEMORY_DIR || env[PROJECT_SCOPE_ENV] === "0") {
+		return { dir: baseDir, collection: DEFAULT_QMD_COLLECTION };
+	}
+
+	const root = gitProjectRoot(cwd);
+	if (!root) return { dir: baseDir, collection: DEFAULT_QMD_COLLECTION };
+
+	const key = projectKey(root);
+	return {
+		dir: path.join(baseDir, "projects", key),
+		collection: `${DEFAULT_QMD_COLLECTION}-${key}`,
+	};
 }
 
