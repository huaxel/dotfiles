+
+function gitProjectRoot(cwd: string): string | null {
+	try {
+		const topLevel = execFileSync("git", ["-C", cwd, "rev-parse", "--show-toplevel"], {
+			encoding: "utf8",
+			stdio: ["ignore", "pipe", "ignore"],
+		}).trim();
+		if (!topLevel) return null;
+
+		// Worktrees share the main repository's git common dir, so they share
+		// project memory instead of silently fragmenting it per worktree.
+		const commonDir = execFileSync("git", ["-C", cwd, "rev-parse", "--git-common-dir"], {
+			encoding: "utf8",
+			stdio: ["ignore", "pipe", "ignore"],
+		}).trim();
+		if (!commonDir) return path.resolve(topLevel);
+		const resolvedCommonDir = path.resolve(cwd, commonDir);
+		return path.basename(resolvedCommonDir) === ".git" ? path.dirname(resolvedCommonDir) : path.resolve(topLevel);
+	} catch {
+		return null;
+	}
+}
+
+function projectKey(projectRoot: string): string {
+	const label = path.basename(projectRoot).replace(/[^A-Za-z0-9._-]/g, "-") || "project";
+	const digest = createHash("sha256").update(projectRoot).digest("hex").slice(0, 12);
+	return `${label}-${digest}`;
+}
+
+/** Explicit aliases only: remotes and directory labels never imply identity.
+ * Missing registry preserves existing scopes. Invalid registry stops resolution
+ * instead of silently sending writes to a different memory directory.
+ */
+function registeredProjectKey(baseDir: string, root: string): string | undefined {
+	const registry = path.join(baseDir, "project-identities.json");
+	let raw: string;
+	try {
+		raw = fs.readFileSync(registry, "utf8");
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+		throw error;
+	}
+	const data = JSON.parse(raw);
+	if (!data || data.version !== 1 || !data.checkouts ||
+		typeof data.checkouts !== "object" || Array.isArray(data.checkouts)) {
+		throw new Error("Invalid project-identities.json: expected version 1 and checkouts object");
+	}
+	for (const [checkout, id] of Object.entries(data.checkouts)) {
+		if (!path.isAbsolute(checkout) || path.normalize(checkout) !== checkout ||
+			typeof id !== "string" || !/^[a-z][a-z0-9-]{0,63}$/.test(id)) {
+			throw new Error("Invalid project-identities.json: use normalized absolute paths and lowercase project IDs");
+		}
+	}
+	return Object.hasOwn(data.checkouts, root) ? data.checkouts[root] : undefined;
+}
+
+let memoryScopeFailure: Error | null = null;
+
+export function assertMemoryScopeReady(): void {
+	if (memoryScopeFailure) throw memoryScopeFailure;
+}
+
+export function activateMemoryScope(cwd: string, env: MemoryEnv = process.env): MemoryScope {
+	try {
+		const scope = resolveMemoryScope(cwd, env);
+		setMemoryScope(scope.dir, scope.collection);
+		memoryScopeFailure = null;
+		return scope;
+	} catch (error) {
+		memoryScopeFailure = new Error("Memory disabled: project identity resolution failed", { cause: error });
+		throw memoryScopeFailure;
+	}
+}
+
+export function resolveMemoryScope(cwd: string, env: MemoryEnv = process.env): MemoryScope {
+	const baseDir = resolveMemoryDir(env);
+	// An explicit PI_MEMORY_DIR remains an exact override for compatibility.
+	if (env.PI_MEMORY_DIR || env[PROJECT_SCOPE_ENV] === "0") {
+		return { dir: baseDir, collection: DEFAULT_QMD_COLLECTION };
+	}
+
+	const root = gitProjectRoot(cwd);
+	if (!root) return { dir: baseDir, collection: DEFAULT_QMD_COLLECTION };
+
+	const key = registeredProjectKey(baseDir, root) ?? projectKey(root);
+	return {
+		dir: path.join(baseDir, "projects", key),
+		collection: `${DEFAULT_QMD_COLLECTION}-${key}`,
+	};
 }
 
