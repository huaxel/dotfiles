#!/usr/bin/env bash
# quality-gauntlet — Run all quality gates against the current project.
#
# Usage:
#   just quality              Run all gates
#   just quality --quick      Skip mutation testing
#   just quality --watch      Watch mode (for TDD loop)
#   just quality --gate lint  Run a single gate
#
# Gates (in order, each depends on prior passing):
#   1. lint       Lint & format checks (zero warnings)
#   2. complexity Cyclomatic/cognitive complexity budgets
#   3. coverage   Test coverage thresholds
#   4. mutation   Mutation testing score
#   5. bdd        Gherkin/BDD acceptance scenarios
#   6. review     Code review (must be run separately via subagent)
#   7. verify     Final verification (all above must pass)
#
# Configuration: .qualityrc (JSON) at project root
# Exit codes: 0 = all gates pass, 1 = one or more gates failed

set -euo pipefail

# ── Globals ──

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
QUALITYRC="$PROJECT_ROOT/.qualityrc"
QUICK_MODE=false
WATCH_MODE=false
SINGLE_GATE=""
PASSED=0
FAILED=0
SKIPPED=0
SCORES=()

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Helpers ──

gate_header() {
    local num="$1" name="$2"
    echo ""
    echo -e "${BOLD}━━━ Gate ${num}: ${name} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
}

gate_pass() {
    local detail="${1:-}"
    PASSED=$((PASSED + 1))
    echo -e "  ${GREEN}✅ PASS${RESET} ${detail}"
}

gate_fail() {
    local reason="${1:-}"
    FAILED=$((FAILED + 1))
    echo -e "  ${RED}❌ FAIL${RESET} ${reason}"
}

gate_skip() {
    local reason="${1:-}"
    SKIPPED=$((SKIPPED + 1))
    echo -e "  ${YELLOW}⏭️  SKIP${RESET} ${reason}"
}

detect_language() {
    # Detect the primary language of the project
    if [ -f "$PROJECT_ROOT/package.json" ]; then
        echo "js"
    elif [ -f "$PROJECT_ROOT/pyproject.toml" ] || [ -f "$PROJECT_ROOT/setup.py" ] || [ -f "$PROJECT_ROOT/requirements.txt" ]; then
        echo "py"
    elif [ -f "$PROJECT_ROOT/Cargo.toml" ]; then
        echo "rs"
    elif [ -f "$PROJECT_ROOT/go.mod" ]; then
        echo "go"
    else
        echo "unknown"
    fi
}

read_qualityrc() {
    local key="$1" default="$2"
    if [ -f "$QUALITYRC" ] && command -v jq &>/dev/null; then
        jq -r "$key // \"$default\"" "$QUALITYRC" 2>/dev/null || echo "$default"
    else
        echo "$default"
    fi
}

# ── Gate 1: Lint & Format ──

gate_lint() {
    gate_header 1 "Lint & Format"
    local lang errors=0

    lang=$(detect_language)

    case "$lang" in
        js)
            # ESLint / Biome
            if command -v npx &>/dev/null && [ -f "$PROJECT_ROOT/node_modules/.bin/eslint" ]; then
                echo "  Running: npx eslint . --max-warnings 0"
                if npx --prefix "$PROJECT_ROOT" eslint "$PROJECT_ROOT" --max-warnings 0 2>&1; then
                    gate_pass "ESLint zero warnings"
                else
                    gate_fail "ESLint has warnings or errors"
                    errors=1
                fi
            elif command -v npx &>/dev/null && npx --prefix "$PROJECT_ROOT" biome check "$PROJECT_ROOT" 2>/dev/null; then
                gate_pass "Biome clean"
            else
                gate_skip "no JS linter configured"
            fi

            # Prettier
            if command -v npx &>/dev/null && [ -f "$PROJECT_ROOT/node_modules/.bin/prettier" ]; then
                echo "  Running: npx prettier --check ."
                if npx --prefix "$PROJECT_ROOT" prettier --check "$PROJECT_ROOT" 2>&1; then
                    gate_pass "Prettier clean"
                else
                    gate_fail "Prettier has formatting issues"
                    errors=1
                fi
            fi
            ;;
        py)
            # Ruff
            if command -v ruff &>/dev/null; then
                echo "  Running: ruff check"
                if ruff check "$PROJECT_ROOT" 2>&1; then
                    gate_pass "Ruff clean"
                else
                    gate_fail "Ruff has issues"
                    errors=1
                fi
                echo "  Running: ruff format --check"
                if ruff format --check "$PROJECT_ROOT" 2>&1; then
                    gate_pass "Ruff format clean"
                else
                    gate_fail "Ruff format has issues"
                    errors=1
                fi
            else
                gate_skip "ruff not installed"
            fi
            ;;
        *)
            # Shell scripts
            if command -v shellcheck &>/dev/null; then
                local sh_files
                sh_files=$(find "$PROJECT_ROOT" -type f \( -name '*.sh' -o -name '*.bash' \) \
                    ! -path '*/node_modules/*' ! -path '*/.git/*' 2>/dev/null || true)
                if [ -n "$sh_files" ]; then
                    local sh_errors=0
                    while IFS= read -r f; do
                        if ! shellcheck -x -s bash "$f" 2>/dev/null; then
                            sh_errors=1
                        fi
                    done <<< "$sh_files"
                    if [ "$sh_errors" -eq 0 ]; then
                        gate_pass "ShellCheck clean"
                    else
                        gate_fail "ShellCheck has issues"
                        errors=1
                    fi
                else
                    gate_skip "no shell scripts found"
                fi
            fi
            ;;
    esac

    return "$errors"
}

# ── Gate 2: Complexity Budget ──

gate_complexity() {
    gate_header 2 "Complexity Budget"
    local lang errors=0

    local max_cyclo max_cognitive max_lines max_params max_file max_depth
    max_cyclo=$(read_qualityrc '.complexity.cyclomatic' "10")
    max_cognitive=$(read_qualityrc '.complexity.cognitive' "15")
    max_lines=$(read_qualityrc '.complexity.maxFunctionLines' "24")
    max_params=$(read_qualityrc '.complexity.maxParams' "3")
    max_file=$(read_qualityrc '.complexity.maxFileLines' "300")
    max_depth=$(read_qualityrc '.complexity.maxNestingDepth' "3")

    echo "  Thresholds: cyclo≤${max_cyclo} | cogn≤${max_cognitive} | func≤${max_lines}ln | params≤${max_params} | file≤${max_file}ln | depth≤${max_depth}"

    lang=$(detect_language)

    case "$lang" in
        js)
            if command -v npx &>/dev/null && [ -f "$PROJECT_ROOT/node_modules/.bin/eslint" ]; then
                # ESLint with complexity rules
                if npx --prefix "$PROJECT_ROOT" eslint "$PROJECT_ROOT" \
                    --rule "complexity: [error, $max_cyclo]" \
                    --rule "max-lines-per-function: [error, $max_lines]" \
                    --rule "max-params: [error, $max_params]" \
                    --rule "max-depth: [error, $max_depth]" \
                    --rule "max-lines: [error, $max_file]" \
                    2>&1; then
                    gate_pass "all complexity budgets met"
                else
                    gate_fail "complexity budget exceeded"
                    errors=1
                fi
            else
                gate_skip "ESLint not available for complexity check"
            fi
            ;;
        py)
            if command -v radon &>/dev/null; then
                echo "  Running: radon cc --min C"
                local radon_out
                radon_out=$(radon cc "$PROJECT_ROOT" --min C 2>&1 || true)
                if [ -z "$radon_out" ]; then
                    gate_pass "radon cyclomatic complexity OK"
                else
                    echo "$radon_out" | sed 's/^/    /'
                    gate_fail "complex functions found (grade D-F)"
                    errors=1
                fi
            else
                gate_skip "radon not installed (pip install radon)"
            fi

            # File length check (simple)
            local long_files
            long_files=$(find "$PROJECT_ROOT" -name '*.py' -type f \
                ! -path '*/test/*' ! -path '*/tests/*' ! -path '*/node_modules/*' \
                -exec wc -l {} + 2>/dev/null | awk -v max="$max_file" '$1 > max {print $2, "("$1" lines)"}')
            if [ -n "$long_files" ]; then
                echo "  Over-length files:"
                echo "$long_files" | sed 's/^/    /'
                gate_fail "files exceed $max_file lines"
                errors=1
            fi
            ;;
        *)
            gate_skip "complexity tool not configured for $lang"
            ;;
    esac

    return "$errors"
}

# ── Gate 3: Test Coverage ──

gate_coverage() {
    gate_header 3 "Test Coverage"
    local lang errors=0

    local min_lines min_branches min_funcs
    min_lines=$(read_qualityrc '.coverage.lines' "80")
    min_branches=$(read_qualityrc '.coverage.branches' "70")
    min_funcs=$(read_qualityrc '.coverage.functions' "90")

    echo "  Thresholds: lines≥${min_lines}% | branches≥${min_branches}% | functions≥${min_funcs}%"

    lang=$(detect_language)

    case "$lang" in
        js)
            if command -v npx &>/dev/null && [ -f "$PROJECT_ROOT/node_modules/.bin/vitest" ]; then
                echo "  Running: npx vitest --coverage --run"
                local cov_out
                cov_out=$(npx --prefix "$PROJECT_ROOT" vitest --coverage --run 2>&1 || true)
                local exit_code=$?

                # Parse coverage from vitest output or coverage report
                local line_cov branch_cov func_cov
                line_cov=$(echo "$cov_out" | grep -oP 'Lines\s+\|\s+\K[\d.]+' | head -1 || echo "0")
                branch_cov=$(echo "$cov_out" | grep -oP 'Branches\s+\|\s+\K[\d.]+' | head -1 || echo "0")
                func_cov=$(echo "$cov_out" | grep -oP 'Functions\s+\|\s+\K[\d.]+' | head -1 || echo "0")

                local cov_ok=true
                if [ -n "$line_cov" ] && awk "BEGIN {exit !($line_cov < $min_lines)}"; then
                    gate_fail "line coverage ${line_cov}% < ${min_lines}%"
                    cov_ok=false
                fi
                if [ -n "$branch_cov" ] && awk "BEGIN {exit !($branch_cov < $min_branches)}"; then
                    gate_fail "branch coverage ${branch_cov}% < ${min_branches}%"
                    cov_ok=false
                fi
                if [ -n "$func_cov" ] && awk "BEGIN {exit !($func_cov < $min_funcs)}"; then
                    gate_fail "function coverage ${func_cov}% < ${min_funcs}%"
                    cov_ok=false
                fi

                if $cov_ok; then
                    gate_pass "lines:${line_cov}% branches:${branch_cov}% funcs:${func_cov}%"
                    SCORES+=("coverage:100")
                else
                    errors=1
                fi
            elif command -v npx &>/dev/null && [ -f "$PROJECT_ROOT/node_modules/.bin/jest" ]; then
                echo "  Running: npx jest --coverage"
                if npx --prefix "$PROJECT_ROOT" jest --coverage 2>&1; then
                    gate_pass "Jest coverage OK (manual threshold check recommended)"
                else
                    gate_fail "Jest tests failed or coverage below threshold"
                    errors=1
                fi
            else
                gate_skip "no JS test runner configured"
            fi
            ;;
        py)
            if command -v pytest &>/dev/null; then
                if python3 -c "import pytest_cov" 2>/dev/null; then
                    echo "  Running: pytest --cov --cov-fail-under=$min_lines"
                    if pytest --cov="$PROJECT_ROOT" --cov-fail-under="$min_lines" "$PROJECT_ROOT" 2>&1; then
                        gate_pass "pytest coverage ≥ ${min_lines}%"
                        SCORES+=("coverage:100")
                    else
                        gate_fail "coverage below ${min_lines}%"
                        errors=1
                    fi
                else
                    gate_skip "pytest-cov not installed (pip install pytest-cov)"
                fi
            else
                gate_skip "pytest not installed"
            fi
            ;;
        *)
            gate_skip "coverage tool not configured for $lang"
            ;;
    esac

    return "$errors"
}

# ── Gate 4: Mutation Testing ──

gate_mutation() {
    gate_header 4 "Mutation Testing"

    if $QUICK_MODE; then
        gate_skip "quick mode — mutation testing bypassed"
        return 0
    fi

    local lang errors=0
    local min_score
    min_score=$(read_qualityrc '.mutation.score' "60")

    echo "  Threshold: mutation score ≥ ${min_score}%"

    lang=$(detect_language)

    case "$lang" in
        js)
            if command -v npx &>/dev/null && [ -f "$PROJECT_ROOT/node_modules/.bin/stryker" ]; then
                echo "  Running: npx stryker run"
                local stryker_out
                stryker_out=$(npx --prefix "$PROJECT_ROOT" stryker run 2>&1 || true)
                local score
                score=$(echo "$stryker_out" | grep -oP 'Mutation score: \K[\d.]+' | head -1 || echo "0")

                if [ -n "$score" ] && awk "BEGIN {exit !($score >= $min_score)}"; then
                    gate_pass "mutation score: ${score}%"
                    SCORES+=("mutation:$score")
                else
                    gate_fail "mutation score ${score:-0}% < ${min_score}%"
                    errors=1
                fi
            else
                gate_skip "stryker not installed (npm install -D @stryker-mutator/core)"
            fi
            ;;
        py)
            if command -v mutmut &>/dev/null; then
                echo "  Running: mutmut run"
                local mutmut_out
                mutmut_out=$(mutmut run 2>&1 || true)
                local killed total
                killed=$(echo "$mutmut_out" | grep -oP '\d+(?= killed)' | head -1 || echo "0")
                total=$(echo "$mutmut_out" | grep -oP '\d+(?= total)' | head -1 || echo "1")
                local score
                score=$(awk "BEGIN {printf \"%.1f\", ($killed/$total)*100}")

                if awk "BEGIN {exit !($score >= $min_score)}"; then
                    gate_pass "mutation score: ${score}% (${killed}/${total})"
                    SCORES+=("mutation:$score")
                else
                    gate_fail "mutation score ${score}% < ${min_score}% (${killed}/${total})"
                    errors=1
                fi
            else
                gate_skip "mutmut not installed (pip install mutmut)"
            fi
            ;;
        *)
            gate_skip "mutation tool not configured for $lang"
            ;;
    esac

    return "$errors"
}

# ── Gate 5: BDD Acceptance ──

gate_bdd() {
    gate_header 5 "BDD Acceptance"
    local lang errors=0

    local features_dir
    features_dir=$(read_qualityrc '.bdd.featuresDir' "features")

    if [ ! -d "$PROJECT_ROOT/$features_dir" ]; then
        gate_skip "no $features_dir/ directory — skipping BDD"
        return 0
    fi

    echo "  Features directory: $features_dir/"

    lang=$(detect_language)

    case "$lang" in
        js)
            if command -v npx &>/dev/null && [ -f "$PROJECT_ROOT/node_modules/.bin/cucumber-js" ]; then
                echo "  Running: npx cucumber-js"
                if npx --prefix "$PROJECT_ROOT" cucumber-js 2>&1; then
                    local count
                    count=$(find "$PROJECT_ROOT/$features_dir" -name '*.feature' | wc -l | tr -d ' ')
                    gate_pass "$count scenarios passed"
                    SCORES+=("bdd:100")
                else
                    gate_fail "BDD scenarios failed"
                    errors=1
                fi
            else
                gate_skip "cucumber-js not installed"
            fi
            ;;
        py)
            if command -v behave &>/dev/null; then
                echo "  Running: behave"
                if behave "$PROJECT_ROOT/$features_dir" 2>&1; then
                    gate_pass "behave scenarios passed"
                    SCORES+=("bdd:100")
                else
                    gate_fail "behave scenarios failed"
                    errors=1
                fi
            else
                gate_skip "behave not installed (pip install behave)"
            fi
            ;;
        *)
            gate_skip "BDD tool not configured for $lang"
            ;;
    esac

    return "$errors"
}

# ── Gate 6: Code Review ──

gate_review() {
    gate_header 6 "Code Review"

    echo "  ℹ️  Code review runs via a separate subagent dispatch."
    echo "  The review subagent must be dispatched before this gate passes."
    echo ""

    # Check if there's a recent review result
    local review_file="$PROJECT_ROOT/.quality-review-result"
    if [ -f "$review_file" ]; then
        local age
        age=$(($(date +%s) - $(stat -c %Y "$review_file" 2>/dev/null || stat -f %m "$review_file" 2>/dev/null || echo 0)))
        if [ "$age" -lt 3600 ]; then
            local result
            result=$(head -1 "$review_file")
            if [ "$result" = "PASS" ]; then
                gate_pass "review approved (${age}s ago)"
                SCORES+=("review:100")
                return 0
            else
                gate_fail "review rejected — fix issues and re-review"
                return 1
            fi
        fi
    fi

    echo "  📋  No recent review found."
    echo "  Dispatch: subagent with agent=reviewer, task=Review changes"
    echo "  Then write 'PASS' or 'FAIL' to $review_file"
    echo ""

    # Interactive mode: prompt
    if [ -t 0 ]; then
        echo -n "  Has the reviewer approved? (y/N): "
        read -r answer
        if [ "$answer" = "y" ] || [ "$answer" = "Y" ]; then
            echo "PASS" > "$review_file"
            gate_pass "review manually confirmed"
            SCORES+=("review:100")
        else
            gate_fail "review not yet approved"
            return 1
        fi
    else
        gate_skip "review pending (run interactively or create .quality-review-result)"
    fi
}

# ── Gate 7: Verification ──

gate_verify() {
    gate_header 7 "Verification"

    # This gate is the meta-check: all previous gates must have passed.
    if [ "$FAILED" -eq 0 ]; then
        gate_pass "all gates passed — verification complete"
        SCORES+=("verify:100")
        return 0
    else
        gate_fail "$FAILED gate(s) failed — fix before verification"
        return 1
    fi
}

# ── Main ──

print_banner() {
    echo ""
    echo -e "${BOLD}${CYAN}╔══════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${CYAN}║           QUALITY GAUNTLET                       ║${RESET}"
    echo -e "${BOLD}${CYAN}╚══════════════════════════════════════════════════╝${RESET}"
    echo ""
    echo "  Project: $(basename "$PROJECT_ROOT")"
    echo "  Language: $(detect_language)"
    local mode="full"
  $QUICK_MODE && mode="quick"
  $WATCH_MODE && mode="watch"
  [ -n "$SINGLE_GATE" ] && mode="gate=$SINGLE_GATE"
  echo "  Mode: $mode"
    if [ -f "$QUALITYRC" ]; then
        echo "  Config:  .qualityrc"
    fi
    echo ""
}

print_summary() {
    local total=$((PASSED + FAILED + SKIPPED))

    echo ""
    echo -e "${BOLD}┌──────────────────────────────────────────────────┐${RESET}"
    printf "${BOLD}│${RESET}  %-46s │\n" "SUMMARY"
    echo -e "${BOLD}├──────────────────────────────────────────────────┤${RESET}"
    printf "  %-46s\n" "Passed:  $PASSED"
    printf "  %-46s\n" "Failed:  $FAILED"
    printf "  %-46s\n" "Skipped: $SKIPPED"

    # Compute quality score
    if [ "$total" -gt 0 ] && [ "$total" -ne "$SKIPPED" ]; then
        local score
        score=$(awk "BEGIN {printf \"%.0f\", ($PASSED / ($PASSED + $FAILED)) * 100}")
        local adjusted
        adjusted=$(awk "BEGIN {printf \"%.0f\", $score * ($PASSED + $FAILED) / $total}")

        echo -e "${BOLD}├──────────────────────────────────────────────────┤${RESET}"
        printf "${BOLD}│${RESET}  Quality Score: %-32s ${BOLD}│${RESET}\n" "${adjusted}/100"

        if [ "$FAILED" -eq 0 ]; then
            echo -e "${BOLD}│${RESET}  Status:  ${GREEN}✅ PASS${RESET}                              ${BOLD}│${RESET}"
        else
            echo -e "${BOLD}│${RESET}  Status:  ${RED}❌ FAIL${RESET}                              ${BOLD}│${RESET}"
        fi
    fi
    echo -e "${BOLD}└──────────────────────────────────────────────────┘${RESET}"
    echo ""
}

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --quick|-q)
            QUICK_MODE=true
            ;;
        --watch|-w)
            WATCH_MODE=true
            ;;
        --gate|-g)
            SINGLE_GATE="$2"
            shift
            ;;
        *)
            echo "Unknown flag: $1"
            echo "Usage: quality-gauntlet [--quick] [--watch] [--gate <name>]"
            exit 1
            ;;
    esac
    shift
done

# Run
print_banner

if [ -n "$SINGLE_GATE" ]; then
    case "$SINGLE_GATE" in
        lint)        gate_lint ;;
        complexity)  gate_complexity ;;
        coverage)    gate_coverage ;;
        mutation)    gate_mutation ;;
        bdd)         gate_bdd ;;
        review)      gate_review ;;
        verify)      gate_verify ;;
        *)
            echo "Unknown gate: $SINGLE_GATE"
            echo "Valid gates: lint, complexity, coverage, mutation, bdd, review, verify"
            exit 1
            ;;
    esac
else
    gate_lint        || true
    gate_complexity  || true
    gate_coverage    || true
    gate_mutation    || true
    gate_bdd         || true
    gate_review      || true
    gate_verify      || true
fi

print_summary

# Exit code: 0 if no failures, 1 otherwise
if [ "$FAILED" -eq 0 ]; then
    exit 0
else
    exit 1
fi
