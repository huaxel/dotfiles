# ─────────────────────────────────────────────────────────────
# Dotter cache (not config)
# ─────────────────────────────────────────────────────────────
.dotter/cache.toml
.dotter/cache/
.dotter_cache/

# ─────────────────────────────────────────────────────────────
# Private / sensitive configs
# ─────────────────────────────────────────────────────────────
config/gh/private_*
# npm registry auth token — secret, never commit (~/.npmrc symlinks to npmrc, keep tokens here)
/.npmrc
config/zed/private_*
config/zed/conversations/
config/zed/embeddings/
config/zed/prompts/
config/qBittorrent/
config/vscode/globalStorage/
config/vscode/workspaceStorage/
config/vscode/History/
config/vscode/sync/

# ─────────────────────────────────────────────────────────────
# Cache / state / binary files
# ─────────────────────────────────────────────────────────────
config/eza/eza-themes/imgs/
config/eza/eza-themes/test_dir/
config/eza/eza-themes/dot_git/
config/wallpapers/
config/vscode/globalStorage/**/*.vscdb
config/vscode/globalStorage/**/*.vscdb.backup
config/vscode/globalStorage/**/*.json
config/vscode/**/*.vscdb
config/vscode/**/*.vscdb.backup
config/composer/*.lock
config/composer/keys.*
config/tmc/
config/nvim/lazy-lock.json

# ─────────────────────────────────────────────────────────────
# OS files
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# Editor files
# ─────────────────────────────────────────────────────────────
*.swp
*.swo
*~
.vscode/
.idea/

# ─────────────────────────────────────────────────────────────
# Local machine config (not shared)
# ─────────────────────────────────────────────────────────────
local/

# Dotter local config (machine-specific)
.dotter/local.toml

# Pi subagents runtime artifacts
.pi-subagents/
prime-agent/agent/update-restarts/

# Pi goal/session runtime artifacts (machine-local: pids, instance ids)
.pi-glla/

# Pi agent machine-local settings (not shared across machines)
pi/agent/pi-goal.json
pi/agent/fff/

# Pi npm extension manifest + lockfile — pi-managed, per-machine, regenerated
# by `pi update --extensions` / `pi install` (source of truth: settings.json)
pi/agent/npm/package.json
pi/agent/npm/package-lock.json

# pi-data-masking global config — contains real secrets/API keys, never commit
pi/agent/pi-data-masking/

# Nested git repos (pi extensions cloned separately)

# ─────────────────────────────────────────────────────────────
# Secrets (decrypted versions — never commit these)
# ─────────────────────────────────────────────────────────────
secrets/*
!secrets/*.enc
!secrets/*.sha256
!secrets/*.sops
!secrets/.gitkeep
!secrets/README.md

# Cursor SDK runtime cache (auto-generated by pi-cursor-sdk)
pi/agent/cursor-sdk-context-windows.json

# Pi extension runtime state (append-only event logs, not source)
pi/agent/state/extensions/pi-eta/events.jsonl

# Age keys (machine-specific)
.config/sops/age/keys.txt
.age-key

# Sops decrypted temp files
*.dec


# Python
__pycache__/
*.pyc
pi/agent/models-store.json

# npm workspace installs (created by `npm install` at repo root)
node_modules/

# Root npm workspace lockfile — generated per-machine by `npm install`
# (pi/packages workspace deps resolve on any clone; lock is not shared)
package-lock.json

# Worksheet audit sidecar — derived per-machine state, not collaboration content.
# The visible Markdown worksheets remain tracked; only the .history event log
# and block-id map are regenerable local artifacts.
.worksheets/.history/
