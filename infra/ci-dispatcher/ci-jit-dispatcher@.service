[Unit]
Description=Ephemeral GitHub Actions JIT dispatcher (%i)
Documentation=https://github.com/huaxel/dotfiles/tree/main/infra/ci-dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Expose only the read-only Nix command profile, not the operator's home.
Environment=PATH=/opt/ci-jit-profile/bin:/usr/local/bin:/usr/bin:/bin
# %i is the host key; each instance loads config.%i.json.
# wherever dotfiles stages it; adjust ExecStart path at install time.
ExecStartPre=/usr/bin/bash -c 'command -v gh >/dev/null && command -v jq >/dev/null && command -v sudo >/dev/null'
ExecStart=/usr/local/libexec/ci-dispatcher/jit-dispatcher.sh /etc/ci-jit-dispatcher/config.%i.json
Restart=always
RestartSec=10
# The dispatcher alone can read the 0600 PAT. It drops each job to the
# separate actions-runner UID through a narrowly scoped sudoers rule. Home
# directories are hidden; only the read-only command profile is bind-mounted.
User=ci-jit-dispatcher
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Optional on Lola, where dispatcher CLI tools are system-installed.
BindReadOnlyPaths=-/home/juan/.nix-profile:/opt/ci-jit-profile
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
CPUWeight=80
MemoryMax=70%
TasksMax=1024
ReadWritePaths=/var/lib/ci-jit-dispatcher /var/lib/ci-jit-runner /var/cache/ci-jit

[Install]
WantedBy=multi-user.target
