# Ghostty Configuration

# Theme
theme = "TokyoNight"

# Font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
window-inherit-font-size = false
font-feature = "calt"
font-feature = "liga"

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell integration
shell-integration = detect

# Window
window-save-state = always
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
mouse-hide-while-typing = true
copy-on-select = clipboard
background-blur-radius = 20
background-opacity = 0.88
clipboard-write = allow

# Keybindings
# Launch a normal terminal window from any app (not the OmniWM overlay).
keybind = global:alt+enter=new_window
# Quick (Quake-style) overlay terminal: Ctrl+` toggles from any app.
# Kept OmniWM-compatible on purpose: OmniWM's toggleQuakeTerminal stays
# unassigned in config-macos/omniwm/settings.toml, so only Ghostty handles
# this chord (no double-toggle). Requires Ghostty Accessibility permission.
keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface
keybind = super+right=goto_split:next
keybind = super+left=goto_split:previous
