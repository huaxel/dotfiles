# Brewfile — curated desired-state package manifest for macOS.
# Install: brew bundle --file=~/.config/Brewfile
# Do not replace this with an unreviewed `brew bundle dump`; that would import
# incidental packages and duplicate Home Manager-owned CLI tools.

tap "felixkratz/formulae"
tap "nikitabobko/tap"
tap "steipete/tap"

# ─── Formulae ──────────────────────────────────────────────────────────────
# Common CLI tools are Home Manager-owned; only macOS/runtime-specific tools
# and bootstrap prerequisites remain here. A tool listed in both places is a
# duplicate version, not a fallback: in an interactive zsh `/opt/homebrew/bin`
# precedes `~/.nix-profile/bin`, so the brew copy wins. That is why the 74
# migrated tools had their brew formulae removed rather than merely shadowed.
# The brew lines left are bootstrap prerequisites (age/git/sops) or tools Nix
# cannot supply. Portable CLI additions belong in home/common.nix; macOS-only
# ones in home/darwin-packages.nix.
brew "age" # bootstrap prerequisite for sops-nix secrets
