# Machine-specific dotter configuration
# Copy this to .dotter/local.toml and set your OS/package set.
# macOS:        packages = ["default", "unix", "macos"]
# Linux / WSL:  packages = ["default", "unix", "linux"]
# Windows:      packages = ["default", "windows"]
#
# "unix" = shared macOS+Linux configs; "macos"/"linux" add OS-specific
# configs (config-macos/, config-linux/) so they don't deploy on the wrong OS.

packages = ["default", "unix", "macos"]

[variables]
# Set to "macos", "linux", or "windows"
os = "macos"
name = "Your Name"
email = "your@email.com"
hostname_color = "fg:#f7768e"
